%% BPMN-style business process: attendance mark and review after event.
%% Export to docs/diagrams/bpmn_join_event_review.png

flowchart TD
    classDef event fill:#ffffff,stroke:#111827,stroke-width:2px,color:#111827
    classDef task fill:#ecfdf5,stroke:#047857,stroke-width:1px,color:#111827
    classDef gateway fill:#fff7ed,stroke:#c2410c,stroke-width:1px,color:#111827
    classDef error fill:#fef2f2,stroke:#b91c1c,stroke-width:1px,color:#111827

    start((Start)):::event
    finish((Review saved)):::event

    subgraph user["Пользователь"]
        openCard["Открывает карточку мероприятия"]:::task
        pressJoin["Нажимает 'Пойду'"]:::task
        attend["Посещает мероприятие"]:::task
        writeReview["Вводит текст отзыва и оценку"]:::task
    end

    subgraph frontend["Frontend"]
        renderCard["Показывает карточку мероприятия и статус участия"]:::task
        sendJoin["POST /api/v1/events/{id}/attendance"]:::task
        showJoined["Отображает статус 'Вы идете' и кнопку календаря"]:::task
        showReminder["Показывает информацию о напоминании"]:::task
        openReviewForm["Открывает форму отзыва после даты события"]:::task
        sendReview["POST /api/v1/events/{id}/reviews"]:::task
        showReviewSaved["Показывает опубликованный отзыв"]:::task
        showReviewError["Показывает ошибку: отзыв пока недоступен"]:::error
    end

    subgraph backend["Backend"]
        checkJwt["Gateway проверяет JWT"]:::task
        saveAttendance["Event Service сохраняет отметку участия"]:::task
        addCalendar["Event Service формирует ICS / календарную ссылку"]:::task
        scheduleReminder["Notification Service планирует напоминание"]:::task
        canReview{"Мероприятие завершилось?"}:::gateway
        saveReview["Event Service сохраняет отзыв"]:::task
        rejectReview["Отказ: 400/403"]:::error
    end

    start --> openCard --> renderCard --> pressJoin --> sendJoin --> checkJwt
    checkJwt --> saveAttendance --> addCalendar --> scheduleReminder --> showJoined --> showReminder --> attend
    attend --> openReviewForm --> writeReview --> sendReview --> canReview
    canReview -->|"Да"| saveReview --> showReviewSaved --> finish
    canReview -->|"Нет"| rejectReview --> showReviewError --> attend
