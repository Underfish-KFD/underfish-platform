%% BPMN-style business process: registration and login.
%% Export to docs/diagrams/bpmn_registration_login.png

flowchart TD
    classDef event fill:#ffffff,stroke:#111827,stroke-width:2px,color:#111827
    classDef task fill:#ecfdf5,stroke:#047857,stroke-width:1px,color:#111827
    classDef gateway fill:#fff7ed,stroke:#c2410c,stroke-width:1px,color:#111827
    classDef error fill:#fef2f2,stroke:#b91c1c,stroke-width:1px,color:#111827

    start((Start)):::event
    finish((Authorized)):::event

    subgraph user["Пользователь"]
        openForm["Открывает форму регистрации / входа"]:::task
        enterData["Вводит email, пароль и OTP при необходимости"]:::task
        receiveToken["Получает авторизованную сессию"]:::task
        fixData["Исправляет данные"]:::task
    end

    subgraph frontend["Frontend"]
        validateForm["Проверяет формат полей"]:::task
        sendRequest["Отправляет запрос в API Gateway"]:::task
        saveTokens["Сохраняет access/refresh token"]:::task
        showError["Показывает ошибку"]:::error
    end

    subgraph backend["Backend"]
        routeAuth["Gateway маршрутизирует запрос в Auth Service"]:::task
        checkEmail{"Email уже зарегистрирован?"}:::gateway
        hashPassword["Хэширование пароля и создание учетной записи"]:::task
        createProfile["Profile Service создает профиль"]:::task
        checkPassword["Проверка пароля и статуса учетной записи"]:::task
        issueJwt["Выпуск JWT и refresh token"]:::task
        reject["Отказ: 400/401"]:::error
    end

    start --> openForm --> enterData --> validateForm
    validateForm -->|"OK"| sendRequest --> routeAuth
    validateForm -->|"Ошибка формы"| showError --> fixData --> enterData
    routeAuth --> checkEmail
    checkEmail -->|"Нет, регистрация"| hashPassword --> createProfile --> issueJwt
    checkEmail -->|"Да, вход"| checkPassword --> issueJwt
    checkEmail -->|"Дубликат при регистрации"| reject --> showError
    checkPassword -->|"Неверный пароль"| reject
    issueJwt --> saveTokens --> receiveToken --> finish
