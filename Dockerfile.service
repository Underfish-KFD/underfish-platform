# ---- Build stage ----
FROM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /workspace

# Copy the repository to build a single service module.
COPY . .

ARG SERVICE
RUN ./gradlew \
    -Dorg.gradle.jvmargs="-Xms128m -Xmx512m -Dfile.encoding=UTF-8" \
    -Dorg.gradle.daemon=false \
    --no-daemon \
    --max-workers=1 \
    :${SERVICE}:bootJar -x test

# ---- Runtime stage ----
FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

ARG SERVICE
COPY --from=builder /workspace/${SERVICE}/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
